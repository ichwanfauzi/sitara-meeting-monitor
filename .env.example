# Local development placeholders only. Replace before use outside local development.
POSTGRES_DB=sitara_dev
POSTGRES_USER=sitara_app
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5432

# Used by FastAPI when running locally from repository root.
DATABASE_URL=postgresql+psycopg://sitara_app:change_me_local_only@localhost:5432/sitara_dev
# Used only by Docker Compose; the host name is the Compose PostgreSQL service.
DATABASE_URL_CONTAINER=postgresql+psycopg://sitara_app:change_me_local_only@postgres:5432/sitara_dev
ACTION_ITEM_EVIDENCE_STORAGE_PATH=/var/lib/sitara/evidence
SITARA_API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Generate a private random value (at least 32 characters) before enabling login.
LOGIN_RATE_LIMIT_HMAC_KEY=
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_STATEMENT_TIMEOUT_MS=2000

# Local ClamAV daemon endpoint. Override the host in containerized environments.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
EVIDENCE_SCAN_POLL_SECONDS=5
